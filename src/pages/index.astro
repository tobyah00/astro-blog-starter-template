---
import Layout from '../layouts/Layout.astro';
import { APP_URL } from '../consts';
---

<Layout title="LiveMusicLocal - Live Music Near You (Beta)" showNav={true}>
	<main class="flex-grow flex flex-col items-center px-4 py-6 sm:py-10 relative overflow-hidden bg-[#121212]">
		<!-- Background Glow Effects -->
		<div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-[100px] pointer-events-none"></div>
		<div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-tertiary/10 rounded-full blur-[100px] pointer-events-none"></div>

		<div class="relative z-10 w-full max-w-2xl mx-auto flex flex-col items-center text-center gap-6 md:gap-8">

			<!-- Logo -->
			<div class="w-36 h-36 md:w-64 md:h-64 relative rounded-full overflow-hidden border border-outline-variant shadow-[0_0_30px_rgba(187,134,252,0.1)]">
				<img
					src="/images/logo-hero.webp"
					width="640"
					height="640"
					fetchpriority="high"
					alt="LiveMusicLocal Logo"
					class="w-full h-full object-cover"
				/>
			</div>

			<!-- Typography & Content -->
			<div class="flex flex-col items-center gap-4 md:gap-6 glass-panel p-5 sm:p-8 rounded-xl border border-outline-variant/30 w-full backdrop-blur-xl bg-surface-container/40">
				<div class="inline-flex items-center gap-2 px-4 py-1.5 border border-secondary rounded-full">
					<span class="relative flex h-2 w-2">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span>
						<span class="relative inline-flex rounded-full h-2 w-2 bg-secondary"></span>
					</span>
					<span class="font-label text-secondary uppercase tracking-[0.1em] text-sm font-bold">
						Now in Open Beta
					</span>
				</div>

				<h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-primary uppercase tracking-wider drop-shadow-[0_0_15px_rgba(187,134,252,0.3)]">
					Find Your Local Music Scene
				</h1>

				<p class="font-body text-on-surface-variant text-base sm:text-lg md:text-xl max-w-lg">
					Discover local artists, venues, and live music near you. Explore the LiveMusicLocal web app, now in open beta.
				</p>

				<!-- CTA Area -->
				<div class="mt-2 flex flex-col sm:flex-row gap-3 w-full justify-center">
					<div class="relative group">
						<div class="absolute -inset-0.5 bg-primary rounded-md blur opacity-30 group-hover:opacity-60 transition duration-200"></div>
						<a href={APP_URL} class="relative block w-full sm:w-auto px-8 py-4 bg-primary text-on-primary font-display text-xl uppercase tracking-wider rounded border border-primary/50 hover:bg-primary-container transition-colors">
							Launch the App
						</a>
					</div>
					<button id="notify-btn" class="w-full sm:w-auto px-6 py-3 bg-transparent text-primary font-body text-base font-medium rounded border border-outline-variant hover:bg-primary/10 transition-colors">
						Get Updates
					</button>
				</div>

				<p class="font-body text-on-surface-variant text-sm max-w-md">
					Free to use in any browser on phone or desktop. Add it to your home screen to install it like an app.
					<span class="text-on-surface">Native iOS and Android apps coming soon.</span>
				</p>

				<p class="font-body text-outline text-xs max-w-md">
					This is an early beta, so things may change and you might hit a bug or two.
					<a href="/contact" class="underline hover:text-primary transition-colors">Send us feedback</a>.
				</p>
			</div>

		</div>

		<section aria-labelledby="app-preview-title" class="relative z-10 w-full max-w-2xl mx-auto mt-12 md:mt-16 text-center">
			<h2 id="app-preview-title" class="font-display text-3xl md:text-4xl text-primary uppercase tracking-wider">A Look Inside the App</h2>
			<p class="mt-3 text-on-surface-variant font-body">Preview the Discover screen, then open the app to explore.</p>
			<figure class="mt-6">
				<img
					src="/images/app-discover-780.webp"
					srcset="/images/app-discover-390.webp 390w, /images/app-discover-780.webp 780w"
					sizes="(max-width: 421px) calc(100vw - 32px), 390px"
					width="780"
					height="1688"
					loading="lazy"
					decoding="async"
					alt="LiveMusicLocal Discover screen showing Next Live Show, Trending Gigs, Upcoming Nearby, and app navigation."
					class="block w-full max-w-[390px] h-auto mx-auto rounded-xl border border-outline-variant/50 shadow-xl"
				/>
				<figcaption class="mt-4 mx-auto max-w-md font-body text-sm text-on-surface-variant">Screenshot of the public beta, captured November 8, 2026. This is a static preview; listings and availability may change. Check current details in the app.</figcaption>
			</figure>
		</section>

		<!-- Notify Modal -->
		<dialog id="notify-modal" aria-labelledby="notify-title" aria-describedby="notify-description" class="m-auto w-full max-w-md bg-transparent p-4 text-on-surface backdrop:bg-black/60 backdrop:backdrop-blur-sm">
			<div class="relative w-full max-w-md bg-surface-container rounded-2xl p-8 border border-outline-variant shadow-2xl glass-panel">
				<button type="button" aria-label="Close updates dialog" id="close-modal" class="absolute top-4 right-4 text-on-surface-variant hover:text-primary transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>

				<h2 id="notify-title" class="text-2xl font-display text-primary mb-4">Get Beta Updates</h2>
				<p id="notify-description" class="text-on-surface-variant mb-6 font-body">Enter your email and we'll let you know about new features and when the iOS and Android apps launch.</p>

				<form action="https://formspree.io/f/xzdonjnv" method="POST" class="flex flex-col gap-4">
					<label for="updates-email" class="font-label text-on-surface">Email address</label>
					<input
						id="updates-email"
						autocomplete="email"
						autofocus
						type="email"
						name="email"
						required
						placeholder="your@email.com"
						class="w-full px-4 py-3 rounded bg-surface border border-outline focus:border-primary focus:ring-1 focus:ring-primary outline-none text-on-surface font-body transition-all"
					/>
					<button type="submit" class="w-full px-6 py-3 bg-primary text-on-primary font-display font-bold uppercase tracking-wider rounded hover:bg-primary-container transition-colors">
						Subscribe
					</button>
				</form>
			</div>
		</dialog>
	</main>
</Layout>


<script>
	const notifyBtn = document.getElementById('notify-btn');
	const notifyModal = document.getElementById('notify-modal');
	const closeModal = document.getElementById('close-modal');
	if (notifyBtn && notifyModal instanceof HTMLDialogElement && closeModal) {
		notifyBtn.addEventListener('click', () => notifyModal.showModal());
		closeModal.addEventListener('click', () => notifyModal.close());
		notifyModal.addEventListener('click', (event) => {
			if (event.target === notifyModal) {
				const bounds = notifyModal.getBoundingClientRect();
				if (event.clientX < bounds.left || event.clientX > bounds.right ||
					event.clientY < bounds.top || event.clientY > bounds.bottom) notifyModal.close();
			}
		});
		notifyModal.addEventListener('close', () => notifyBtn.focus());
	}
</script>

<style>

	/* Glassmorphism utility if needed beyond Tailwind setup */
	.glass-panel {
		background: rgba(26, 26, 26, 0.4);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}
</style>
