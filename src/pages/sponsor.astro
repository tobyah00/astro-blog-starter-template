---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Become a Sponsor - LiveMusicLocal" showNav={true}>
	<main class="flex-grow flex flex-col items-center justify-start p-8 relative overflow-hidden bg-[#121212]">
		<div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-[100px] pointer-events-none"></div>

		<div class="relative z-10 w-full max-w-2xl mx-auto flex flex-col gap-8">
			<h1 class="font-display text-4xl md:text-6xl text-primary uppercase tracking-wider text-center">
				Partner With Us
			</h1>
            <p class="text-center font-body text-on-surface-variant text-lg">
                Interested in reaching local music fans? Let's talk about sponsorship opportunities.
            </p>

			<div class="glass-panel p-8 rounded-xl border border-outline-variant/30 backdrop-blur-xl bg-surface-container/40">
                <form action="https://formspree.io/f/xzdonjnv" method="POST" class="flex flex-col gap-6">

                    <div class="flex flex-col md:flex-row gap-6">
                        <div class="flex flex-col gap-2 flex-1">
                            <label for="firstName" class="font-label text-on-surface text-sm uppercase tracking-wider">First Name</label>
                            <input type="text" id="firstName" name="firstName" required class="w-full px-4 py-3 rounded bg-surface border border-outline focus:border-primary focus:ring-1 focus:ring-primary outline-none text-on-surface font-body transition-all" />
                        </div>
                        <div class="flex flex-col gap-2 flex-1">
                            <label for="lastName" class="font-label text-on-surface text-sm uppercase tracking-wider">Last Name</label>
                            <input type="text" id="lastName" name="lastName" required class="w-full px-4 py-3 rounded bg-surface border border-outline focus:border-primary focus:ring-1 focus:ring-primary outline-none text-on-surface font-body transition-all" />
                        </div>
                    </div>

                    <div class="flex flex-col gap-2">
                        <label for="company" class="font-label text-on-surface text-sm uppercase tracking-wider">Company / Organization</label>
                        <input type="text" id="company" name="company" required class="w-full px-4 py-3 rounded bg-surface border border-outline focus:border-primary focus:ring-1 focus:ring-primary outline-none text-on-surface font-body transition-all" />
                    </div>

                    <div class="flex flex-col gap-2">
                        <label for="email" class="font-label text-on-surface text-sm uppercase tracking-wider">Business Email</label>
                        <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded bg-surface border border-outline focus:border-primary focus:ring-1 focus:ring-primary outline-none text-on-surface font-body transition-all" />
                    </div>

                    <div class="flex flex-col gap-2">
                        <label for="interest" class="font-label text-on-surface text-sm uppercase tracking-wider">Sponsorship Interest</label>
                        <select id="interest" name="interest" class="w-full px-4 py-3 rounded bg-surface border border-outline focus:border-primary focus:ring-1 focus:ring-primary outline-none text-on-surface font-body transition-all appearance-none">
                            <option value="general">General Inquiry</option>
                            <option value="event">Event Sponsorship</option>
                            <option value="digital">Digital Advertising</option>
                            <option value="partnership">Long-term Partnership</option>
                        </select>
                    </div>

                    <div class="flex flex-col gap-2">
                        <label for="message" class="font-label text-on-surface text-sm uppercase tracking-wider">Additional Details</label>
                        <textarea id="message" name="message" rows="4" class="w-full px-4 py-3 rounded bg-surface border border-outline focus:border-primary focus:ring-1 focus:ring-primary outline-none text-on-surface font-body transition-all resize-none"></textarea>
                    </div>

                    <button type="submit" class="mt-4 w-full px-6 py-4 bg-primary text-on-primary font-display font-bold uppercase tracking-wider rounded hover:bg-primary-container transition-colors text-lg">
                        Submit Inquiry
                    </button>
                </form>
			</div>
		</div>
	</main>
</Layout>

<style>
	.glass-panel {
		background: rgba(26, 26, 26, 0.4);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}
</style>
